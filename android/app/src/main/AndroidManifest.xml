<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- /sdcard/Lesefuchs/inbox lesen: bis API 32 klassisch, ab API 30 zusätzlich
         All-Files-Access (auf dem Gerät einmalig freischalten, siehe README).
         Fallback ohne Freigabe: /sdcard/Android/data/de.lesefuchs.spike/files/inbox -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:label="Lesefuchs Spike"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SpikeActivity"
            android:exported="true"
            android:label="Lesefuchs Technik-Spike" />
    </application>
</manifest>
