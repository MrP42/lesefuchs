# WAI Portal — Apache-Konfiguration (IONOS Webhosting Pro)

# Alle Anfragen an den Front-Controller leiten (außer existierende Dateien)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    # HTTP -> HTTPS erzwingen (301; HSTS unten greift erst NACH dem ersten
    # HTTPS-Besuch — ohne diese Regel bliebe ein Erstbesuch ueber http unverschluesselt)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    # index.php selbst niemals umschreiben (verhindert Endlosschleife auf IONOS)
    RewriteRule ^index\.php$ - [L]
    # Agent-API (Bearer-Auth): IONOS/Apache-FastCGI schluckt den Authorization-Header
    # teils, bevor er PHP erreicht. Als $_SERVER['REDIRECT_HTTP_AUTHORIZATION']
    # zugänglich machen (App\Middleware\ApiTokenGuard liest ihn als Fallback).
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    # nur umschreiben, wenn KEINE echte Datei/Verzeichnis angefragt wird
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Agent-API Bearer-Auth: Authorization-Header zuverlässig an PHP-FastCGI durchreichen.
# Auf IONOS füllt die RewriteRule-Variante oben oft NICHTS (Header wird vor mod_rewrite
# gestrippt); mod_setenvif greift früher und setzt HTTP_AUTHORIZATION direkt.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
    SetEnvIf Authorization "(.+)" REDIRECT_HTTP_AUTHORIZATION=$1
</IfModule>

# Sicherheits-Header (gelten Apache-weit, also auch für statische Dateien,
# die am PHP-Front-Controller vorbeilaufen)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS für die gesamte Subdomain (nur über HTTPS ausgeliefert; TLS liegt vor).
    # includeSubDomains ist unbedenklich, da unter portal.* keine weiteren Hosts liegen.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Kompression für Text-Assets (statische Dateien werden von PHP nicht komprimiert).
# Bereits komprimierte Formate (woff2, png, jpg, pdf, Office) bleiben unangetastet.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        application/xml application/json image/svg+xml \
        text/javascript application/javascript application/x-javascript
</IfModule>

# Cache-Header für statische Assets. CSS/JS werden per ?v=filemtime versioniert
# (Cachebuster), daher ist eine lange Cache-Dauer unbedenklich.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType text/javascript          "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/jpeg               "access plus 1 year"
    ExpiresByType image/gif                "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"
    ExpiresByType image/x-icon             "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType font/woff                "access plus 1 year"
    ExpiresByType font/ttf                 "access plus 1 year"
    # Downloads (Angebote) moderat cachen – können in-place aktualisiert werden.
    ExpiresByType application/pdf                                                                  "access plus 1 week"
    ExpiresByType application/vnd.openxmlformats-officedocument.presentationml.presentation        "access plus 1 week"
    ExpiresByType application/vnd.openxmlformats-officedocument.wordprocessingml.document          "access plus 1 week"
    ExpiresByType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet                "access plus 1 week"
</IfModule>

# Direktzugriff auf sensible Dateien sperren
<FilesMatch "(^\.env|\.sqlite|\.log|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# Verzeichnislisting aus, MultiViews aus (stört Front-Controller)
Options -Indexes -MultiViews
