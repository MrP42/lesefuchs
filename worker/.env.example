# Lesefuchs Worker — Konfiguration (kopieren nach .env und anpassen)

# Ollama (Vorlese-Optimierung, Konzept §6.3a)
LF_OLLAMA_URL=http://127.0.0.1:11434
LF_OLLAMA_MODEL=gemma3:12b
LF_OLLAMA_TIMEOUT_S=300

# Fish-Speech (TTS, lokale RTX 4090 — siehe C:\AI\fish-speech)
LF_FISH_URL=http://127.0.0.1:8080
LF_FISH_REFERENCE_ID=
LF_FISH_SEED=42
LF_FISH_TIMEOUT_S=600

# Rücktranskriptions-Check
LF_VERIFY_MODEL=small
LF_VERIFY_WER_THRESHOLD=0.15
LF_VERIFY_MAX_ATTEMPTS=3

# Alignment
LF_ALIGN_DEVICE=cuda

# Audio
LF_PAUSE_BETWEEN_PARAGRAPHS_MS=350
LF_OPUS_BITRATE=24k
LF_OPUS_SAMPLE_RATE=22050

# Paket
LF_READING_LEVEL=2
LF_VOICE_LABEL=fish-s2pro
LF_LANGUAGE=de-DE

# Verzeichnisse (relativ zum Aufrufort oder absolut)
LF_WORK_DIR=work
LF_OUT_DIR=out
